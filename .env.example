# Public site URL (used for metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://burnedoutadvisor.com

# Real contact details for Imprint/Disclaimer. They render only when set.
# (The live WordPress site shows placeholders: support@ex.comburnedout.xyz / 5555555555.)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Where the retreat "Reserve My Spot" button sends people. Defaults to the WordPress FluentCart checkout.
NEXT_PUBLIC_RETREAT_CHECKOUT_URL=

# Server-side: webhook that receives webinar + contact submissions as JSON
# ({ kind: "webinar" | "contact", submittedAt, firstName, lastName, email, ... }).
# Required in production. In development, submissions are logged to the console instead.
FORM_WEBHOOK_URL=
